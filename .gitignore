# 环境变量（包含 API 密钥）
.env

# 数据库文件
data/

# Python 缓存
__pycache__/
*.py[cod]
*$py.class

# Windows 保留设备名误生成的空文件（来自 shell 重定向）
nul

# 虚拟环境
.venv/
venv/

# uv 本地缓存
.uv-cache/
.tmp/
pytest-cache-files-*/
tmp_pytest/
tmp*/
codex-pytest-temp/
codex-pytest-review-*/
codex_pytest_review_*/
codex-manual-check/
codex-manual-check-pipeline/

# IDE
.vscode/
.idea/
uv.lock
.claude/settings.local.json
.zcode/settings.local.json

# ZCode 会话产物（每次会话自动生成，不入库）
.zcode/plans/

# EDD eval 运行产物（每次运行临时生成，不入库）
eval/run_latest.json

# 检索评估运行产物（DB 快照 + 历次报告，不入库；scripts/queries/golden_labels 入库）
docs/eval/eval_snapshot.db
docs/eval/snapshot_meta.json
docs/eval/results/

# Frontend
frontend/node_modules/
frontend/dist/


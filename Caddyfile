# Caddyfile — reverse proxy for knowledge-cli MCP server
#
# Streamable HTTP (MCP 2024-11-05) uses chunked transfer encoding.
# Disable buffering on the MCP route so streaming responses reach
# clients immediately.

# ------------------------------------------------------------------
# Primary: kg.yiyiyiwufeng.cn via Cloudflare Tunnel (edge terminates
# TLS; origin is plain HTTP, hence the explicit http:// scheme which
# also keeps Caddy from attempting ACME for this name)
# ------------------------------------------------------------------
http://kg.yiyiyiwufeng.cn {
    handle /admin* {
        reverse_proxy admin:8001
    }

    handle /api/v1* {
        reverse_proxy admin:8001
    }

    handle /api/docs* {
        reverse_proxy admin:8001
    }

    handle /api/redoc* {
        reverse_proxy admin:8001
    }

    handle /openapi.json {
        reverse_proxy admin:8001
    }

    handle /mcp* {
        reverse_proxy mcp:8000 {
            flush_interval -1
        }
    }

    handle /health {
        reverse_proxy mcp:8000
    }

    respond 404
}

# ------------------------------------------------------------------
# Fallback: {$DOMAIN} or localhost
# ------------------------------------------------------------------
{$DOMAIN:localhost} {
    handle /admin* {
        reverse_proxy admin:8001
    }

    handle /api/v1* {
        reverse_proxy admin:8001
    }

    handle /api/docs* {
        reverse_proxy admin:8001
    }

    handle /api/redoc* {
        reverse_proxy admin:8001
    }

    handle /openapi.json {
        reverse_proxy admin:8001
    }

    handle /mcp* {
        reverse_proxy mcp:8000 {
            flush_interval -1
        }
    }

    handle /health {
        reverse_proxy mcp:8000
    }

    respond 404
}

# ------------------------------------------------------------------
# fin-trace agent (Graph Explorer)
# Cloudflare Tunnel origin (plain HTTP, edge terminates TLS).
# flush_interval -1 禁用缓冲，保证 SSE 流式回复实时到达。
# ------------------------------------------------------------------
http://fin.yiyiyiwufeng.cn {
    reverse_proxy fin-trace:3001 {
        flush_interval -1
    }
}

# Caddyfile — reverse proxy for knowledge-cli MCP server
#
# Streamable HTTP (MCP 2024-11-05) uses chunked transfer encoding.
# Disable buffering on the MCP route so streaming responses reach
# clients immediately.

# ------------------------------------------------------------------
# Primary: nip.io (free DNS, auto Let's Encrypt cert)
# ------------------------------------------------------------------
182-61-1-77.nip.io {
    handle /mcp* {
        reverse_proxy mcp:8000 {
            flush_interval -1
        }
    }

    handle /health {
        reverse_proxy mcp:8000
    }

    respond 404
}

# ------------------------------------------------------------------
# Fallback: {$DOMAIN} or localhost
# ------------------------------------------------------------------
{$DOMAIN:localhost} {
    handle /mcp* {
        reverse_proxy mcp:8000 {
            flush_interval -1
        }
    }

    handle /health {
        reverse_proxy mcp:8000
    }

    respond 404
}

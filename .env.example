# ============================================================
# Financial Knowledge Retrieval Foundation - Environment Template
# Copy to .env and fill in your values: cp .env.example .env
# ============================================================

# --- LLM API (Required for KnowledgeUnit extraction) ---
ANTHROPIC_API_KEY=your-api-key-here
# ANTHROPIC_API_BASE_URL=https://api.anthropic.com
# ANTHROPIC_MODEL=claude-sonnet-4-20250514
# ANTHROPIC_MAX_TOKENS=4096

# --- LLM Scene Separation (Optional, falls back to ANTHROPIC_MODEL) ---
# OFFLINE_LLM_MODEL=claude-sonnet-4-20250514
# OFFLINE_LLM_MAX_TOKENS=4096

# --- Admin Dashboard ---
# Bootstrap: set this and a default admin user is created on first startup.
# Once users exist, the token continues to work as a super-admin bypass.
# ADMIN_TOKEN=your-admin-token-here
# JWT signing secret. If not set, auto-generated on each startup (invalidates existing tokens).
# JWT_SECRET=your-random-secret-here

# --- Neo4j Knowledge Graph ---
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your-password-here

# --- MCP Server API Key ---
# Protect the MCP endpoint with a Bearer token.
# Set to empty to skip auth (local dev only).
# MCP_API_KEY=your-secret-key-here

# --- Cloudflare Tunnel (production only) ---
# Token of the Named Tunnel that fronts caddy:80 (kg./fin.yiyiyiwufeng.cn).
# Created in Cloudflare Zero Trust -> Networks -> Tunnels; the cloudflared
# service in the infra compose (deploy/infra/) reads this via env_file.
# Leave unset for local dev.
# TUNNEL_TOKEN=eyJ...

# --- Deploy image pinning (production only) ---
# Managed by deploy.sh on the server: set to the sha-<commit> tag CI pushed
# to GHCR so the ingestion/fetch systemd units (`docker compose run --rm mcp`)
# resolve the same image as the running service. Leave unset for local dev.
# IMAGE_TAG=master

# --- Dense retrieval embeddings (VectorIndex / FAISS) ---
# OpenAI-compatible /embeddings endpoint. Without these the semantic stage is
# skipped (explicitly marked in retrieval output, not an error).
# The API key must be set explicitly here even when reusing the same SiliconFlow
# account as the reranker (SILICONFLOW_API_KEY below) — no silent fallback.
# Switching to a model with a different vector dimension requires rebuilding the
# index: knowledge-cli index-vectors --rebuild
# OPENAI_EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
# OPENAI_EMBEDDING_API_KEY=your-key-here
# OPENAI_EMBEDDING_MODEL=BAAI/bge-m3
# Alternative (OpenRouter free tier):
# OPENAI_EMBEDDING_BASE_URL=https://openrouter.ai/api/v1
# OPENAI_EMBEDDING_API_KEY=your-key-here
# OPENAI_EMBEDDING_MODEL=nvidia/llama-nemotron-embed-vl-1b-v2:free

# --- Reranker (SiliconFlow /rerank, free tier, direct domestic access) ---
# Register at https://siliconflow.cn, create an API key, fill it here.
# Without a key retrieval falls back to weighted-fusion ordering (explicitly
# labeled, no rerank suffix on retrieval_mode).
# SILICONFLOW_API_KEY=sk-xxx
# SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
# SILICONFLOW_RERANK_MODEL=BAAI/bge-reranker-v2-m3

# --- Retrieval tuning (optional) ---
# Semantic hard-filter threshold on the entity route (dense cosine, default 0.30).
# Below-threshold candidates are dropped, then backfilled up to top_k if the cut
# was too aggressive. Calibrate against docs/eval runs before changing.
# SEMANTIC_FILTER_THRESHOLD=0.30
# How many fused-top candidates to send to the reranker (default 50).
# RERANK_POOL_N=50
# Set to 1 to force the no-reranker degraded mode (used by the eval gate for
# deterministic runs; do not set in production).
# KNOWLEDGE_RERANK_DISABLED=0

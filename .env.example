# ============================================================
# Financial Knowledge Retrieval Foundation - Environment Template
# Copy to .env and fill in your values: cp .env.example .env
# ============================================================

# --- LLM API (Required for KnowledgeUnit extraction) ---
ANTHROPIC_API_KEY=your-api-key-here
# ANTHROPIC_API_BASE_URL=https://api.anthropic.com
# ANTHROPIC_MODEL=claude-sonnet-4-20250514
# ANTHROPIC_MAX_TOKENS=4096

# --- LLM Scene Separation (Optional, falls back to ANTHROPIC_MODEL) ---
# ONLINE_LLM_MODEL=claude-sonnet-4-20250514
# ONLINE_LLM_MAX_TOKENS=1024
# OFFLINE_LLM_MODEL=claude-sonnet-4-20250514
# OFFLINE_LLM_MAX_TOKENS=4096

# --- Admin Dashboard ---
# Bootstrap: set this and a default admin user is created on first startup.
# Once users exist, the token continues to work as a super-admin bypass.
# ADMIN_TOKEN=your-admin-token-here
# JWT signing secret. If not set, auto-generated on each startup (invalidates existing tokens).
# JWT_SECRET=your-random-secret-here

# --- Neo4j Knowledge Graph ---
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your-password-here

# --- MCP Server API Key ---
# Protect the MCP endpoint with a Bearer token.
# Set to empty to skip auth (local dev only).
# MCP_API_KEY=your-secret-key-here

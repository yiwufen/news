# knowledge-fetch.service
# Continuously runs the EastMoney crawl loop. Mirrors knowledge-ingestion:
# a long-running `docker compose run --rm mcp ...` container that advances by
# writing data/logs/fetch.log each cycle.
#
# Without this unit the fetch container dies on every host/container restart
# (it is a `run --rm` one-shot launch) and nothing brings it back, so news
# collection silently stops. Restart=always recovers it.
#
# Install:
#   sudo cp deploy/knowledge-fetch.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now knowledge-fetch.service

[Unit]
Description=Knowledge CLI Continuous Fetch (EastMoney crawler)
Requires=docker.service
After=docker.service

[Service]
Type=simple
WorkingDirectory=/home/deployer/knowledge/repo
ExecStart=/usr/bin/docker compose --env-file /home/deployer/knowledge/.env run --rm mcp python -m src.cli _run_fetch
Restart=always
RestartSec=30
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target

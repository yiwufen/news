# knowledge-mcp.service
# Ensures the knowledge-cli MCP stack (Caddy + MCP server + Neo4j) is running.
#
# Install:
#   sudo cp deploy/knowledge-mcp.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now knowledge-mcp.service

[Unit]
Description=Knowledge CLI MCP Server (Docker Compose)
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/knowledge/repo
ExecStart=/usr/bin/docker compose --env-file /opt/knowledge/.env up -d --remove-orphans
ExecStop=/usr/bin/docker compose down
ExecReload=/usr/bin/docker compose --env-file /opt/knowledge/.env up -d --build --remove-orphans
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target

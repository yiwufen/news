# knowledge-mcp.service
# Ensures the knowledge-cli app stack (MCP server + Admin + Neo4j) is running.
# Ingress (Caddy + Cloudflare Tunnel) runs in the standalone infra compose
# at /home/deployer/knowledge/infra/ and is not managed by this unit.
#
# Install:
#   sudo cp deploy/knowledge-mcp.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now knowledge-mcp.service

[Unit]
Description=Knowledge CLI MCP Server (Docker Compose)
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/home/deployer/knowledge/repo
ExecStart=/usr/bin/docker compose --env-file /home/deployer/knowledge/.env up -d --remove-orphans
ExecStop=/usr/bin/docker compose down
ExecReload=/usr/bin/docker compose --env-file /home/deployer/knowledge/.env up -d --no-build --remove-orphans
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
